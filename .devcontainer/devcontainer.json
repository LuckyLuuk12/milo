// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python + Bun",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.10-bullseye",
	"features": {
		"ghcr.io/va-h/devcontainers-features/uv:1": {},
		"ghcr.io/devcontainers/features/node:1": {
			"version": "lts"
		}
	},
	"onCreateCommand": "uv venv --allow-existing && uv pip install --python .venv/bin/python --extra-index-url https://europe-west3-python.pkg.dev/rasa-releases/rasa-pro-python/simple rasa-pro && uv pip install --python .venv/bin/python -r requirements.txt && curl -fsSL https://bun.sh/install | bash && git config core.hooksPath .githooks",
	"customizations": {
		"vscode": {
			"settings": {
				"python.terminal.activateEnvironment": true,
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
			}
		}
	},
	"remoteEnv": {
		"MAX_NUMBER_OF_PREDICTIONS": "50",
		"BUN_INSTALL": "/home/vscode/.bun",
		"PATH": "/home/vscode/.bun/bin:${containerEnv:PATH}"
	},
	"remoteUser": "vscode"
}